# Extracted Claude Code binary contents stay local; only prompt texts, provenance, and scripts are published.
work/
# A work folder linked in from the main checkout (a worktree's symlink) is ignored too.
/claude-code/work
/codex/work
/opencode/work
node_modules
site/node_modules
site/dist/
site/.wrangler/
.DS_Store
.worktrees/
.superpowers/

# Local secrets (the tour's voiceover key lives here). Never committed.
.env

# Local only: frozen sessions, video media, research. Never published (tools/leak-check.mjs).
private/
# Video pipelines: installed deps and render output
video/*/edit/node_modules/
video/*/edit/out/
video/*/edit/public/
__pycache__/
.claude/worktrees/
# capture.sh keeps an unfiled recording in the folder it ran from; never commit one
/capture-*.har

# Cursor's per-occurrence Jev inventory (every eligible occurrence and verdict) is ~200 MB, over
# GitHub's and the host's file limits; it stays local until a compact download format exists.
cursor/outputs/inventory.json
# The findings video timelines carry evidence rows from private logs
video/findings/edit/src/timeline*.json
